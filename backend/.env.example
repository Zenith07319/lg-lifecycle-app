# 이 파일을 복사해 .env 로 저장하고 값을 채우세요. (.env 는 git 제외)
# Supabase: Project Settings → Database → Connection string(URI) 복사 후 비밀번호 채움.
# ⚠ 비밀번호 특수문자는 URL 인코딩: @ -> %40, # -> %23, : -> %3A, / -> %2F
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres
# 로컬 SQLite로 돌리려면: DATABASE_URL=sqlite:///./lg_lifecycle.db
APP_ENV=development
SECRET_KEY=dev-secret-please-change-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
